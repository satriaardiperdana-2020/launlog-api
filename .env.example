# Copy to .env for local development and fill in local-only values.
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
READINESS_TIMEOUT=2s
APP_TIMEZONE=Asia/Jakarta
# Local development database only; production uses a separate least-privilege runtime role.
DATABASE_URL=postgres://launlog:launlog@localhost:5432/launlog?sslmode=disable
# Optional outside production. Use a distinct schema-owner account for deployed migrations.
MIGRATION_DATABASE_URL=
CORS_ALLOWED_ORIGINS=
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
JWT_SIGNING_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
